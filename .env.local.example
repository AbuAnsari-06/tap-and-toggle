# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key (Never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Webhook Secret (for verifying incoming webhooks)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Operator Portal Authentication (Admin Session Secret & Password)
ADMIN_PASSWORD=your-secure-operator-password
ADMIN_SESSION_SECRET=your-32-character-random-session-secret


